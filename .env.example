# SHODASHA Browser - environment configuration template
#
# Copy this file to `.env` and fill in values for local development.
# NEVER commit a real `.env` file. Secrets are read exclusively from the
# process environment (see packages/core/src/security/secrets.ts).
#
# The core loads no secrets by default. Add environment-specific keys here
# only when a feature actually requires them (e.g. telemetry opt-in flags).

# Logging level: debug | info | warn | error
SHODASHA_LOG_LEVEL=info

# Set to "true" to enable development-only diagnostics.
SHODASHA_DEV_MODE=false
